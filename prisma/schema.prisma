generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Admin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Driver {
  id             String          @id @default(cuid())
  name           String
  phone          String
  email          String?
  licenseDocUrl  String?
  ghanaCardUrl   String?
  irisScanUrl    String?
  status         String          @default("PENDING")
  balance        Float           @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  passwordHash   String          @default("")

  assignedVehicle Vehicle?       @relation("AssignedDriver")
  reports         DriverReport[]
  partsExchanges  PartsExchange[]
  salesRecords    SalesRecord[]
  ledgerEntries   LedgerEntry[]
  applicationRef  Application?   @relation("ApplicationDriver")

  sentMessages     ChatMessage[]    @relation("MessageSender")
  conversations1   ChatConversation[] @relation("ConvDriver1")
  conversations2   ChatConversation[] @relation("ConvDriver2")
}

model Vehicle {
  id              String          @id @default(cuid())
  plateNumber     String          @unique
  make            String
  model           String
  year            Int
  severityStatus  String          @default("GREEN")
  gpsDeviceId     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  assignedDriverId String?        @unique
  assignedDriver   Driver?        @relation("AssignedDriver", fields: [assignedDriverId], references: [id])

  reports          DriverReport[]
  partsExchanges   PartsExchange[]
  locationPings    LocationPing[]
}

model Application {
  id            String   @id @default(cuid())
  fullName      String
  phone         String
  email         String?
  reason        String
  licenseDocUrl String?
  ghanaCardUrl  String?
  irisScanUrl   String?
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  approvedDriverId String? @unique
  approvedDriver   Driver? @relation("ApplicationDriver", fields: [approvedDriverId], references: [id])
}

model DriverReport {
  id                String   @id @default(cuid())
  type              String
  description       String
  photoUrl          String?
  suggestedSeverity String?
  status            String   @default("NEW")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  driverId  String
  driver    Driver  @relation(fields: [driverId], references: [id])
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
}

model PartsExchange {
  id                  String   @id @default(cuid())
  partName            String
  cost                Float
  date                DateTime
  photoUrl            String?
  receiptUrl          String?
  reimbursementStatus String   @default("PENDING")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  driverId  String
  driver    Driver  @relation(fields: [driverId], references: [id])
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
}

model SalesRecord {
  id              String   @id @default(cuid())
  weekLabel       String
  amount          Float
  paymentMethod   String
  momoReference   String?
  confirmationStatus String @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  driverId String
  driver   Driver @relation(fields: [driverId], references: [id])
}

model LedgerEntry {
  id          String   @id @default(cuid())
  amount      Float
  direction   String
  description String
  createdAt   DateTime @default(now())

  driverId String
  driver   Driver @relation(fields: [driverId], references: [id])
}

model LocationPing {
  id          String   @id @default(cuid())
  lat         Float
  lng         Float
  timestamp   DateTime @default(now())

  vehicleId   String
  vehicle     Vehicle @relation(fields: [vehicleId], references: [id])
  gpsDeviceId String?
}

model ChatConversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driver1Id String
  driver1   Driver @relation("ConvDriver1", fields: [driver1Id], references: [id])
  driver2Id String
  driver2   Driver @relation("ConvDriver2", fields: [driver2Id], references: [id])

  messages ChatMessage[]

  @@unique([driver1Id, driver2Id])
}

model ChatMessage {
  id        String   @id @default(cuid())
  content   String
  mediaUrl  String?
  mediaType String?
  createdAt DateTime @default(now())
  read      Boolean  @default(false)

  senderId       String
  sender         Driver           @relation("MessageSender", fields: [senderId], references: [id])
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id])
}
